# Copie ce fichier vers .env et personnalise.
# .env n'est PAS commité (voir .gitignore).

# --- Siyuan kernel ---
# Code d'accès Siyuan : requis car le conteneur est accédé depuis l'extérieur
# de 127.0.0.1 (réseau bridge Docker). Long et aléatoire en prod, simple en dev.
SIYUAN_ACCESS_AUTH_CODE=dev-change-me

# Token API Siyuan (Settings → About → API token). À régénérer après le premier
# boot Siyuan, puis remplir ici. Server-side only — JAMAIS exposé au reader.
SIYUAN_TOKEN=

# --- Extracteur ---
# Secret partagé entre plugin et extracteur. Configuré dans Settings du plugin
# (Webhook secret) ET ici. timingSafeEqual côté extracteur.
EXTRACTOR_WEBHOOK_SECRET=dev-webhook-secret

# Niveau de log de l'extracteur : trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# --- Reader ---
# Secret pour Auth.js. Génère avec : openssl rand -base64 32
READER_AUTH_SECRET=

# Clé API Resend pour l'envoi des magic-links
RESEND_API_KEY=

# Sender vérifié sur Resend (ex: noreply@tondomaine.com)
READER_EMAIL_FROM=

# Email admin (bootstrap + accès endpoints /api/admin/*)
ADMIN_EMAIL=

# --- Système ---
TZ=Europe/Paris
PUID=1000
PGID=1000
